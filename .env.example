# Copy to .env and fill in real values locally. Never commit .env.

# --- App ---
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_BASE_DIR=logs
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Docker Compose local stack (one application named qa-platform) ---
# Postgres itself is NOT containerized in compose.yaml — the api/worker/migrate
# containers connect out to your local Postgres install via DB_HOST below.
# POSTGRES_USER/PASSWORD/DB here must match an existing user+database in your
# local Postgres, not "whatever init's a new volume" (there's no volume to init).
DB_HOST=host.docker.internal
POSTGRES_USER=qa_platform
POSTGRES_PASSWORD=qa_platform
POSTGRES_DB=qa_platform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
WORKER_MAX_JOBS=1
WORKER_JOB_TIMEOUT=1200

# Host path of artifacts/automation. Leave empty to hide IDE open links.
# Example: D:\testing-platform\QA-testing-Backend\artifacts\automation
AUTOMATION_HOST_ROOT=
AUTOMATION_ARTIFACT_DIR=artifacts/automation

# --- Database (Section 26) ---
DATABASE_URL=postgresql+asyncpg://qa_platform:qa_platform@localhost:5432/qa_platform

# --- Object storage (Section 23) — screenshots/video/trace/HAR, never in Postgres ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000     # MinIO locally, S3 in prod
OBJECT_STORAGE_BUCKET=qa-platform-evidence
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Cache / queue (Section 24/33) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=5

# --- Test design (Agent 3) ---
# Generate ACs in parallel and keep each LLM payload small.
LLM_MAX_CONCURRENT_REQUESTS=2
# Optional override; must be a model your Groq key can access.
# llama-3.1-8b-instant is enterprise-only on current Groq accounts.
TEST_DESIGN_LLM_MODEL=openai/gpt-oss-20b
TEST_DESIGN_AC_BATCH_SIZE=2
TEST_DESIGN_LLM_TIMEOUT_SECONDS=120
TEST_DESIGN_MAX_TOKENS=1800

# --- Secrets manager (Section 20/28) — credential_ref resolves through here, never in agent context ---
SECRETS_BACKEND=vault              # vault | aws_kms
VAULT_ADDR=
VAULT_TOKEN=

# Required to encrypt credentials submitted to the backend credential API.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- LLM ---
# Switching model/provider is ALWAYS a change in this block, never in code —
# see infra/llm/factory.py. Uncomment exactly one preset below (or write your
# own openai_compatible one for another provider) and leave the rest commented.

# Option A — Anthropic (paid, needs a real key)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Option B — Groq (FREE, no credit card, fast — good default while you don't
# have an Anthropic key; get a key at console.groq.com). Llama 3.1/3.3 models
# are confirmed to support tool calling, which call_structured() depends on.
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Option C — OpenAI (paid)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=

# Option D — xAI / Grok (paid, OpenAI-compatible)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=grok-4
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=

# Option E — Ollama (FREE, fully local/offline — run `ollama pull llama3.1`
# first, then `ollama serve`). No API key needed.
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# Option F - Google Gemini (alias: LLM_PROVIDER=gemini)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# GOOGLE_API_KEY or LLM_API_KEY also work. No LLM_BASE_URL is needed.

# --- chrome-devtools-mcp (Discovery + Failure Reproduction only — Section 10/11) ---
CHROME_DEVTOOLS_MCP_ISOLATED=true
CHROME_DEVTOOLS_MCP_REDACT_NETWORK_HEADERS=true

# --- Auth (Section 28) ---
# Optional shared API key. Leave empty for local development. When set, every
# /api/v1 request must send Authorization: Bearer <key> or X-API-Key: <key>.
API_KEY=
OAUTH_ISSUER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Restrict discovery targets. Comma-separated hosts; "*.example.com" wildcards.
# Empty = any public host (private/loopback still follow ENVIRONMENT).
DISCOVERY_ALLOWED_HOSTS=
# Local Docker Compose defaults this to true so the worker can crawl apps on
# host.docker.internal or other private addresses. Set false to enforce SSRF rules.
DISCOVERY_ALLOW_PRIVATE_TARGETS=

# --- Per-project defaults (overridable per project — Section 22/9) ---
DEFAULT_CONFIDENCE_THRESHOLD=0.7
DEFAULT_CRAWL_MAX_PAGES=150
DEFAULT_CRAWL_MAX_DEPTH=6
DEFAULT_CRAWL_MAX_DURATION_SECONDS=900
# Automatic discovery circuit breakers (normal completion uses queue exhaustion)
DISCOVERY_AUTO_MAX_STATES=10000
DISCOVERY_AUTO_MAX_DEPTH=50
DISCOVERY_AUTO_MAX_DURATION_SECONDS=21600
