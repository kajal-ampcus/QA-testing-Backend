# Phase 0 stub — a working image, not yet optimized (multi-stage build, layer caching
# tuning) — revisit before Production phase (Section 35).
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
COPY apps/ apps/
COPY core/ core/
COPY domain/ domain/
COPY schemas/ schemas/
COPY infra/ infra/

RUN pip install --no-cache-dir -e .

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
