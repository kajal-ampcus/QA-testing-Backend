FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ARG CHROME_DEVTOOLS_MCP_VERSION=1.10.1
ARG PKCE_CHALLENGE_VERSION=6.0.0
WORKDIR /app
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Install the browser runtime before application source so ordinary code
# changes reuse this expensive layer. Debian's Chromium package avoids
# Playwright downloading a second 135 MB Google Chrome archive.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates \
        chromium \
        fonts-liberation \
        fonts-noto-color-emoji \
        novnc \
        websockify \
        x11vnc \
        xvfb \
    && chromium --version \
    && rm -rf /var/lib/apt/lists/*

# Local OCR for letters, digits, and symbols drawn in a login captcha image.
RUN apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Pin the MCP runtime so a new upstream release cannot break reproducible builds.
RUN npm install --global \
        "chrome-devtools-mcp@${CHROME_DEVTOOLS_MCP_VERSION}" \
        "pkce-challenge@${PKCE_CHALLENGE_VERSION}" \
    && chrome-devtools-mcp --version \
    && npm cache clean --force

COPY pyproject.toml README.md ./
COPY apps/ apps/
COPY core/ core/
COPY domain/ domain/
COPY schemas/ schemas/
COPY infra/ infra/
ENV PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=10

RUN python -m pip install \
    --no-cache-dir \
    --prefer-binary \
    .
RUN python -c "import pathlib,tomllib; pathlib.Path('/tmp/qa-dependencies.txt').write_text('\n'.join(tomllib.loads(pathlib.Path('pyproject.toml').read_text())['project']['dependencies']))"
RUN --mount=type=cache,target=/root/.cache/pip pip install --timeout 120 --retries 5 -r /tmp/qa-dependencies.txt
# Keep Playwright's browser cache in a predictable location for the worker.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Install browser and MCP at build time; no runtime package downloads. Debian
# supplies Chromium, and /usr/local/bin/google-chrome remains a compatibility alias.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && mkdir -p /opt/ms-playwright \
    && playwright install --with-deps chromium \
    && python -c "from pathlib import Path; import shutil; binary=shutil.which('chromium') or shutil.which('chromium-browser'); assert binary, 'Chromium executable was not installed'; target=Path('/usr/local/bin/google-chrome'); target.unlink(missing_ok=True); target.symlink_to(Path(binary).resolve()); print(target, '->', Path(binary).resolve())" \
    && chmod -R a+rX /opt/ms-playwright \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*
COPY apps/ apps/
COPY core/ core/
COPY domain/ domain/
COPY schemas/ schemas/
COPY infra/ infra/
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-deps --timeout 120 --retries 5 .
COPY scripts/docker_entrypoint.py scripts/run_worker.py scripts/
RUN useradd --create-home --uid 10001 qa \
    && mkdir -p /app/artifacts/discovery /app/artifacts/automation /app/logs \
    && chown -R qa:qa /app/artifacts /app/logs
USER qa
ENTRYPOINT ["python", "scripts/docker_entrypoint.py"]
CMD ["python", "scripts/run_worker.py"]
