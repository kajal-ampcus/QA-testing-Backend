# Phase 0 stub. Also needs Playwright's browser binaries installed
# (`playwright install --with-deps chromium`) once apps/worker/tasks has real content —
# this is the image that actually runs Test Execution (Section 14).
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
COPY apps/ apps/
COPY core/ core/
COPY domain/ domain/
COPY schemas/ schemas/
COPY infra/ infra/

RUN pip install --no-cache-dir -e .
# RUN playwright install --with-deps chromium   # uncomment once Execution agent is implemented

# CMD set once the worker/queue library is chosen — see docs/PROJECT_STRUCTURE.md
CMD ["echo", "worker entrypoint not yet chosen"]
